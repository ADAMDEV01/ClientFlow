# Local PostgreSQL (docker compose)
DATABASE_URL="postgresql://clientflow:clientflow_dev_password@localhost:5432/clientflow?schema=public"

# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-this-with-a-random-secret-at-least-32-characters"
AUTH_URL="http://localhost:3000"
NODE_ENV="development"

# Production S3-compatible private object storage (required in production)
S3_BUCKET=""
S3_REGION="eu-central-1"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Optional for S3-compatible providers such as R2 or MinIO
S3_ENDPOINT=""
# Local development storage directory (defaults to .clientflow-storage)
CLIENTFLOW_LOCAL_STORAGE_DIR=".clientflow-storage"
